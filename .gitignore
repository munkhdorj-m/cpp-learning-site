# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Self-hosted Monaco, copied out of node_modules by scripts/copy-monaco.mjs on
# every dev/build. 6 MB of vendor output — regenerated, never committed.
/public/monaco/

# Self-hosted SQLite (sql.js), copied by scripts/copy-sqljs.mjs on every
# build. Vendor output, same reasoning as Monaco above.
/public/sql-wasm/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/.chrome-profile/
scripts/.spoj-cookies.txt

# Migration data backups (contain student PII — never commit)
migration/backup/
migration/mysql-data.sql

# Locally uploaded assignment files. On the server these live under
# UPLOAD_DIR, outside the application directory.
/var/
